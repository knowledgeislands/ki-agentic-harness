#!/bin/sh
# Canonical pre-commit for a ki-repo-homebrew-tap repository without a package.json, composed by ki-repo.
# Copied byte-exact from ki-repo-homebrew-tap's assets/githooks/no-package/pre-commit; HOOK-4 compares it, so do not edit it here.
git diff --cached --quiet && exit 0
missing=''
for tool in rumdl ruby; do
  if ! command -v "$tool" >/dev/null 2>&1; then missing="$missing $tool"; fi
done
if [ -n "$missing" ]; then
  echo "pre-commit: the commit gate cannot run; not on PATH:$missing" >&2
  echo "pre-commit: install them, then commit again." >&2
  echo "pre-commit: do not bypass with --no-verify; a gate that cannot run is unknown, not a pass." >&2
  exit 1
fi
# Staged Markdown, checked where it stands (ki-authoring MD-hook).
git diff --cached --name-only --diff-filter=ACMR -z -- '*.md' | xargs -0 -r rumdl check --quiet -- || exit 1
# Staged Ruby, syntax-checked with warnings (ki-repo-homebrew-tap GATE-1).
git diff --cached --name-only --diff-filter=ACMR -z -- '*.rb' | xargs -0 -r -n 1 ruby -wc >/dev/null || exit 1

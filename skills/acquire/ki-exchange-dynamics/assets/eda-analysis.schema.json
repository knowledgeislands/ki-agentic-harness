{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/knowledgeislands/ki-agent-backpack/skills/acquire/ki-exchange-dynamics/assets/eda-analysis.schema.json",
  "title": "Exchange dynamics analysis",
  "description": "One structured, evidence-linked analysis of one exchange. Cross-references are checked by scripts/validate-analysis.ts.",
  "type": "object",
  "required": ["schema_version", "exchange", "participants", "events", "phases", "takeaways", "overall"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "exchange": {
      "type": "object",
      "required": ["id", "title", "source_kind", "completeness", "missing_context", "sensitivity"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "source_kind": {
          "enum": ["messaging", "email", "meeting-transcript", "negotiation", "community", "human-ai", "multi-agent", "other"]
        },
        "source": { "type": "string", "description": "Path of the source transcript, relative to this document" },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "start": { "type": "string" }, "end": { "type": "string" } }
        },
        "language": { "type": "string" },
        "completeness": { "enum": ["complete", "partial", "excerpt"] },
        "missing_context": { "type": "array", "items": { "type": "string" } },
        "sensitivity": { "enum": ["ordinary", "sensitive", "legal"] }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "display_name", "initials", "tone", "role", "assertiveness", "trajectory", "evidence", "alternatives", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "initials": { "type": "string", "minLength": 1 },
          "avatar": { "type": "string", "description": "Reference to a supplied avatar; never an invented likeness" },
          "tone": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "assertiveness": { "enum": ["low", "moderate", "high"] },
          "trajectory": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
          "alternatives": { "type": "array", "items": { "type": "string" } },
          "confidence": { "$ref": "#/$defs/confidence" }
        }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "speaker", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "speaker": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "speaker", "quotation", "context", "interpretation", "contribution", "sentiment", "tension", "tags", "phase", "evidence", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "speaker": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string" },
          "quotation": { "type": "string", "minLength": 1 },
          "context": { "type": "string" },
          "interpretation": { "type": "string", "minLength": 1 },
          "contribution": { "type": "string", "minLength": 1 },
          "sentiment": {
            "type": "object",
            "required": ["label", "score", "basis"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "score": { "type": "integer", "minimum": -5, "maximum": 5 },
              "basis": { "type": "string", "minLength": 1 }
            }
          },
          "tension": {
            "type": "object",
            "required": ["score", "band", "basis"],
            "additionalProperties": false,
            "properties": {
              "score": { "type": "integer", "minimum": 0, "maximum": 10 },
              "band": { "enum": ["green", "yellow", "amber", "red"] },
              "basis": { "type": "string", "minLength": 1 }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "enum": ["defensiveness", "cooperation", "escalation", "de-escalation", "perspective-change", "turning-point"]
            }
          },
          "phase": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "confidence": { "$ref": "#/$defs/confidence" },
          "inference": { "type": "string", "description": "A possible motive, always read as inference, never as fact" }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "from", "to", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "from": { "type": "integer", "minimum": 1 },
          "to": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "takeaways": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "events"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "events": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "overall": {
      "type": "object",
      "required": ["character", "tension_sources", "turning_points", "resolution", "uncertainties", "alternatives"],
      "additionalProperties": false,
      "properties": {
        "character": { "type": "string", "minLength": 1 },
        "tension_sources": { "type": "array", "items": { "type": "string" } },
        "turning_points": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "resolution": { "enum": ["resolved", "partial", "unresolved", "unclear"] },
        "uncertainties": { "type": "array", "items": { "type": "string" } },
        "alternatives": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outputs": { "type": "array", "items": { "enum": ["infographic", "report", "pdf"] } },
        "layout": { "enum": ["landscape", "stacked"] },
        "show_scores": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "confidence": { "enum": ["low", "medium", "high"] }
  }
}

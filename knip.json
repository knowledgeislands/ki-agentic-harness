{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "skills/*/*/scripts/*.ts",
    "skills/*/*/scripts/rubric/items/index.ts",
    "skills/*/*/scripts/rubric/types.ts",
    "skills/*/*/scripts/shared/*.ts",
    "skills/*/*/scripts/**/*.test.ts",
    "evals/**/*.test.ts",
    "hooks/**/*.test.ts"
  ],
  "project": ["skills/*/*/scripts/**/*.ts", "evals/**/*.ts", "hooks/**/*.ts"],
  "ignore": [".claude/skills/**", ".agents/skills/**"],
  "ignoreBinaries": ["codex", "op"],
  "ignoreDependencies": ["syncpack"],
  "ignoreExportsUsedInFile": true
}

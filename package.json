{
  "name": "@knowledgeislands/ki-agentic-harness",
  "description": "Knowledge Islands agentic harness — canonical home for Agent Skills, Agents, MCP servers, and Evals across the Knowledge Islands ecosystem.",
  "version": "1.0.0",
  "author": "kris@kris.me.uk",
  "bugs": {
    "url": "https://github.com/knowledgeislands/ki-agentic-harness/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.1",
    "husky": "^9.1.7",
    "knip": "^6.36.0",
    "lint-staged": "^17.5.1",
    "rumdl": "^0.2.73",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/knowledgeislands/ki-agentic-harness#readme",
  "keywords": [
    "agent-skills",
    "anthropic",
    "claude",
    "claude-code",
    "knowledge-islands",
    "multi-runtime",
    "skills"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "bunx @biomejs/biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "bunx rumdl check --fix"
    ]
  },
  "packageManager": "bun@1.4.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/ki-agentic-harness.git"
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "ki:binding:claude:build-plugin": "bun skills/environment/ki-binding-claude/scripts/build-plugin.ts",
    "ki:deps:update": "bun update --latest",
    "ki:harness:eval": "bun evals/harness.ts",
    "prepare": "husky",
    "test": "bun test --isolate --max-concurrency=1 ./skills ./hooks ./evals"
  },
  "type": "module"
}

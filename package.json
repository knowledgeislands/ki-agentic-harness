{
  "name": "@knowledgeislands/ki-agent-backpack",
  "description": "Knowledge Islands agent backpack — canonical home for Agent Skills, Agents, Evals, and Hooks across the ecosystem.",
  "version": "1.0.0",
  "author": "kris@kris.me.uk",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "rumdl": "^0.3.0",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/knowledgeislands/ki-agent-backpack#readme",
  "keywords": [
    "agent-skills",
    "anthropic",
    "bun",
    "claude",
    "claude-code",
    "knowledge-islands",
    "multi-runtime",
    "skills",
    "typescript"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --no-errors-on-unmatched"
    ],
    "*.md": [
      "rumdl check"
    ]
  },
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/ki-agent-backpack.git"
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "ki:deps:update": "bun update --latest",
    "ki:harness:eval": "bun evals/harness.ts",
    "prepare": "git config core.hooksPath .githooks",
    "self:diagrams:html": "bun skills/authoring/ki-diagrams/scripts/build-html.ts",
    "test": "bun test --isolate --max-concurrency=1 ./skills ./hooks ./evals"
  },
  "type": "module"
}

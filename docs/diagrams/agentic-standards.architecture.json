  "cards": [
    {
      "dot": "cyan",
      "title": "The standards",
      "items": [
        "MCP: an agent to its tools and data",
        "ACP: one client to one agent (Zed, JetBrains)",
        "AHP: many clients to one agent host, sharing its sessions; it builds on ACP",
        "A2A: an agent to an opaque remote agent in another system, found by its Agent Card"
      ]
    },
    {
      "dot": "amber",
      "title": "Channels (provisional, CARD-CHANNEL)",
      "items": [
        "Intra-system: peer messages between sessions, Orca's worker mail",
        "Inter-system: AHP and A2A, and our Cairn store, which is polled",
        "An integration joins two closed systems through a shared point, as the Telegram plugin does"
      ]
    },
    {
      "dot": "violet",
      "title": "Agent kinds (provisional, AGENT-KINDS)",
      "items": [
        "Subagent: inside a session, subordinate to its agent",
        "Peer agent: another agent in the same system",
        "Remote agent: an agent in another system, opaque"
      ]
    }
  ]

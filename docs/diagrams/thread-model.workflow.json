  "cards": [
    {
      "dot": "emerald",
      "title": "One loop",
      "items": [
        "An owner message is logged in the owner's words before any work it authorises launches.",
        "The coordinator writes only the work package, the decisions log and a brief; a detached agent does the work.",
        "The agent ends with an owner report and DONE; the coordinator sends a Summary and the owner answers by tag."
      ]
    },
    {
      "dot": "cyan",
      "title": "Who owns each step",
      "items": [
        "ki-coordination: how coordinating work behaves, its Summary, marks and finishing.",
        "ki-delegation: the run packet, prompt shape, authority footers, run queue and reporting.",
        "ki-work-package, ki-git and the ki-work family: the work folder, the agent's commits and the record's lifecycle."
      ]
    },
    {
      "dot": "slate",
      "title": "Marks and close",
      "items": [
        "At a mark the coordinator homes each logged decision under its life cycle and prunes the work folder.",
        "On finish it homes what remains, sets the state finished, deletes the work folder and closes the runs."
      ]
    }
  ]

  "cards": [
    {
      "dot": "emerald",
      "title": "One loop",
      "items": [
        "An owner message is logged in the owner's words before any work it authorises launches.",
        "The thread writes only the checkpoint, the decisions log and a brief; a detached agent does the work.",
        "The agent ends with an owner report and DONE; the thread answers with a Summary and a reply block."
      ]
    },
    {
      "dot": "cyan",
      "title": "Who owns each step",
      "items": [
        "ki-pmo: how the coordinating thread behaves, its Summary, marks and Project close.",
        "ki-delegation: the run packet, prompt shape, authority footers, decisions log and owner report.",
        "ki-git and the ki-work family: the agent's commits and the work record's lifecycle."
      ]
    },
    {
      "dot": "slate",
      "title": "Marks and close",
      "items": [
        "At a mark the thread classifies each logged decision into its durable home and tidies its folder.",
        "At Project close it promotes what remains, removes its checkpoint, deletes the folder and closes the run."
      ]
    }
  ]

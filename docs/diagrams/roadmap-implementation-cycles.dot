// Canonical source for the roadmap and implementation cycles. Regenerate with:
// dot -Tsvg roadmap-implementation-cycles.dot -o roadmap-implementation-cycles.svg
//
// Solid arrows move an item between lifecycle states. Dashed arrows show
// orchestration or optional delegation. Gold diamonds are manual authority gates.
digraph roadmap_implementation_cycles {
  graph [
    bgcolor="#fbfcfe"
    fontname="Helvetica"
    fontsize=20
    label=<
      <b>Knowledge Islands roadmap and implementation cycles</b><br/>
      <font point-size="12">Roadmap selection prepares work · implementation delivers it · acceptance closes it · a batch coordinates authorised cycles without removing authority</font>
    >
    labelloc=t
    margin=0.35
    newrank=true
    nodesep=0.35
    rankdir=TB
    ranksep=0.4
    splines=ortho
  ]

  node [
    color="#8291a6"
    fontcolor="#172033"
    fontname="Helvetica"
    fontsize=13
    margin="0.18,0.14"
    penwidth=1.25
    shape=box
    style="rounded,filled"
  ]

  edge [
    arrowsize=0.75
    color="#5f7087"
    fontcolor="#41546d"
    fontname="Helvetica"
    fontsize=10
    penwidth=1.15
  ]

  subgraph cluster_roadmap {
    color="#afc5db"
    fontcolor="#294866"
    fontname="Helvetica"
    fontsize=14
    label="Roadmap cycle — select and prepare"
    style="rounded"

    recap [fillcolor="#e8edf3", label=< <b>ki-recap</b><br/><font point-size="10">ground live session state</font> >]
    capture [fillcolor="#e1e9fb", label=< <b>Triage / draft</b><br/><font point-size="10">captured · unadopted</font> >]
    candidate [fillcolor="#e1e9fb", label=< <b>Future / Soon</b><br/><font point-size="10">adopted roadmap item</font> >]
    next [fillcolor="#e8edf3", label=< <b>ki-next</b><br/><font point-size="10">capture · adopt · rank · select</font> >]
    adopt_gate [fillcolor="#fff0b8", label=< <b>Manual adoption</b><br/><font point-size="10">destination · boundary</font> >, shape=diamond]
    disposition_gate [fillcolor="#fff0b8", label=< <b>Manual intake disposition</b><br/><font point-size="10">outcome · rationale · target</font> >, shape=diamond]
    select_gate [fillcolor="#fff0b8", label=< <b>Manual selection</b><br/><font point-size="10">priority · horizon · scope</font> >, shape=diamond]
    planned [fillcolor="#e1e9fb", label=< <b>Next / open</b><br/><font point-size="10">selected roadmap item</font> >]
    plan [fillcolor="#e8edf3", label=< <b>ki-plan</b><br/><font point-size="10">shape executable plan</font> >]
    ready_gate [fillcolor="#fff0b8", label=< <b>Manual ready gate</b><br/><font point-size="10">steps · scope · checks</font> >, shape=diamond]
    ready [fillcolor="#d9f0e2", label=< <b>Ready</b><br/><font point-size="10">execution-ready item</font> >]

    recap -> next [style=dashed]
    capture -> next
    next -> adopt_gate
    adopt_gate -> candidate [xlabel="approve"]
    next -> disposition_gate [xlabel="reject / duplicate / merge"]
    candidate -> next
    next -> select_gate
    select_gate -> planned [xlabel="confirm"]
    planned -> plan
    plan -> ready_gate
    ready_gate -> ready [xlabel="approve"]
  }

  subgraph cluster_implementation {
    color="#a8cfbd"
    fontcolor="#24543d"
    fontname="Helvetica"
    fontsize=14
    label="Implementation cycle — deliver one ready item"
    style="rounded"

    implement [fillcolor="#e8edf3", label=< <b>ki-implement</b><br/><font point-size="10">bounded single-item delivery</font> >]
    progress [fillcolor="#d9f0e2", label=< <b>In progress</b><br/><font point-size="10">baseline recorded</font> >]
    verification [fillcolor="#d9f0e2", label=< <b>Verified delivery</b><br/><font point-size="10">required checks pass</font> >]
    acceptance [fillcolor="#d9f0e2", label=< <b>Acceptance</b><br/><font point-size="10">evidence packet ready</font> >]
    ready -> implement [lhead=cluster_implementation]
    implement -> progress
    progress -> verification
    verification -> acceptance
  }

  subgraph cluster_acceptance {
    color="#d9c78d"
    fontcolor="#6f5118"
    fontname="Helvetica"
    fontsize=14
    label="Acceptance and cleanup — close deliberately"
    style="rounded"

    acceptance_gate [fillcolor="#fff0b8", label=< <b>Manual acceptance</b><br/><font point-size="10">review evidence + concerns</font> >, shape=diamond]
    accept [fillcolor="#e8edf3", label=< <b>ki-accept</b><br/><font point-size="10">delivery or intake closure · retained record</font> >]
    done [fillcolor="#efe5c4", label=< <b>Done</b><br/><font point-size="10">retained completion record</font> >]
    prune [fillcolor="#efe5c4", label=< <b>ki-accept prune</b><br/><font point-size="10">explicit confirmed cleanup</font> >]
    pruned [fillcolor="#f1f3f5", label=< <b>Pruned</b><br/><font point-size="10">removed after retention</font> >]

    acceptance -> acceptance_gate
    acceptance_gate -> accept [xlabel="approve"]
    disposition_gate -> accept [lhead=cluster_acceptance, xlabel="approve"]
    accept -> done
    done -> prune [xlabel="recap / next may recommend"]
    prune -> pruned [xlabel="confirm exact items"]
    done -> recap [constraint=false, xlabel="next session"]
  }

  subgraph cluster_batch {
    color="#c4b3de"
    fontcolor="#503d78"
    fontname="Helvetica"
    fontsize=14
    label="Authorised batch — prepare, then run bounded delivery"
    style="rounded,dashed"

    batch_prepare [fillcolor="#f0ebfa", label=< <b>ki-batch preparation</b><br/><font point-size="10">coordinate named next + plan work</font> >]
    batch_gate [fillcolor="#fff0b8", label=< <b>Manual batch authorisation</b><br/><font point-size="10">named items · authority · stops</font> >, shape=diamond]
    batch_run [fillcolor="#f0ebfa", label=< <b>ki-batch run</b><br/><font point-size="10">fresh grounding · early questions · bounded cycle</font> >]
    park [fillcolor="#f6d9d9", label=< <b>Park</b><br/><font point-size="10">ambiguity or authority stop</font> >]

    planned -> batch_prepare [style=dashed, constraint=false, xlabel="approved candidate set"]
    batch_prepare -> batch_gate
    batch_gate -> batch_run [xlabel="approve"]
    batch_run -> implement [style=dashed, constraint=false, xlabel="one ready item at a time"]
    batch_run -> park [xlabel="stop / escalate"]
    park -> recap [style=dashed, constraint=false, xlabel="record + return"]
    batch_run -> acceptance_gate [style=dashed, constraint=false]
  }
}

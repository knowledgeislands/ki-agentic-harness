#!/bin/sh
# Committed pre-commit gate, bound by `core.hooksPath` so every working tree runs it.
# Without its tools it refuses the commit rather than letting it pass unchecked.
root="$(git rev-parse --show-toplevel)" || exit 1
missing=''
for tool in lint-staged syncpack tsc; do
  [ -x "$root/node_modules/.bin/$tool" ] || missing="$missing $tool"
done
if [ -n "$missing" ]; then
  echo "pre-commit: the commit gate cannot run; missing from node_modules/.bin:$missing" >&2
  echo "pre-commit: run \`bun install\` in $root, then commit again." >&2
  echo "pre-commit: do not bypass with --no-verify; a gate that cannot run is unknown, not a pass." >&2
  exit 1
fi
missing=''
for tool in ki bun; do
  if ! command -v "$tool" >/dev/null 2>&1; then missing="$missing $tool"; fi
done
if [ -n "$missing" ]; then
  echo "pre-commit: the commit gate cannot run; not on PATH:$missing" >&2
  echo "pre-commit: install them, then commit again." >&2
  echo "pre-commit: do not bypass with --no-verify; a gate that cannot run is unknown, not a pass." >&2
  exit 1
fi
PATH="$root/node_modules/.bin:$PATH"
export PATH
lint-staged --quiet || exit 1
syncpack format --check || exit 1

# Validate the staged snapshot through the direct KI surface. Split renames into
# delete/add paths so moving a governed file cannot hide its original scope.
staged() { git diff --cached --name-only --no-renames --diff-filter=ACMDT; }
staged_paths="$(staged)" || exit 1
matches_staged() { printf '%s\n' "$staged_paths" | grep -Eq "$1"; }

# Stay quiet on a pass; on a failure, audit again in full so the evidence prints.
quiet_audit() {
  ki repo audit --concise --progress never --reporter-levels FAIL "$@" && return 0
  ki repo audit "$@"
  return 1
}

audit_staged_skills() {
  snapshot="$(mktemp -d)" || return 1
  focus="$(mktemp -d)" || return 1
  trap 'rm -rf "$snapshot" "$focus"' EXIT HUP INT TERM
  git checkout-index --all --prefix="$snapshot/" || return 1
  cp "$snapshot/.ki.toml" "$focus/.ki.toml" || return 1
  for path in AGENTS.md CLAUDE.md README.md package.json docs; do
    if [ -e "$snapshot/$path" ]; then cp -R "$snapshot/$path" "$focus/$path" || return 1; fi
  done

  # Set-level collision, ownership, and shared-provider checks need the unchanged
  # siblings as well as the staged roots.
  find "$snapshot/skills" -mindepth 3 -maxdepth 3 -type f -name SKILL.md | sort | while IFS= read -r skill_file; do
    root="${skill_file%/SKILL.md}"
    relative_root="${root#"$snapshot"/}"
    mkdir -p "$focus/$(dirname "$relative_root")" || exit 1
    cp -R "$root" "$focus/$relative_root" || exit 1
  done || return 1

  # ki-self is the canonical repository-local sibling and participates in the same
  # skill-quality audit even though it is intentionally outside the shared tree.
  if [ -d "$snapshot/.agents/skills/ki-self" ]; then
    mkdir -p "$focus/.agents/skills" || return 1
    cp -R "$snapshot/.agents/skills/ki-self" "$focus/.agents/skills/ki-self" || return 1
  cp "$snapshot/.ki.toml" "$focus/.agents/.ki.toml" || return 1
  fi

  quiet_audit --repo "$focus" --skill ki-skills || return 1
  if [ -d "$focus/.agents/skills/ki-self" ]; then
    quiet_audit --repo "$focus/.agents" --skill ki-skills || return 1
  fi
  result=$?
  trap - EXIT HUP INT TERM
  rm -rf "$snapshot" "$focus"
  return "$result"
}

# A committed diagram viewer must carry a receipt matching its staged source and
# HTML. The staged snapshot's own checker runs, so the check is the one the commit
# carries, and it needs neither Archify nor a browser.
check_staged_receipts() {
  receipts="$(mktemp -d)" || return 1
  git checkout-index --all --prefix="$receipts/" || { rm -rf "$receipts"; return 1; }
  bun "$receipts/skills/governance/ki-diagrams/scripts/build-html.ts" --check --repo "$receipts"
  result=$?
  rm -rf "$receipts"
  return "$result"
}

if matches_staged '\.ts$'; then tsc --noEmit || exit 1; fi
if matches_staged '^(skills/|\.agents/skills/ki-self/)'; then audit_staged_skills || exit 1; fi
if matches_staged '^(docs/diagrams/|skills/governance/ki-diagrams/)'; then check_staged_receipts || exit 1; fi

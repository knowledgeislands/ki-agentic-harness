#!/bin/sh
# Committed stub bound by `core.hooksPath` so every working tree, including a linked
# worktree with no install, resolves a hook. Without the gate's tooling it refuses the
# commit rather than letting Git find no hook and commit unchecked; with it, it runs
# the governed Husky hook unchanged.
root="$(git rev-parse --show-toplevel)" || exit 1
missing=''
for tool in commitlint; do
  [ -x "$root/node_modules/.bin/$tool" ] || missing="$missing $tool"
done
if [ -n "$missing" ]; then
  echo "commit-msg: the commit gate cannot run; missing from node_modules/.bin:$missing" >&2
  echo "commit-msg: run \`bun install\` in $root, then commit again." >&2
  echo "commit-msg: do not bypass with --no-verify; a gate that cannot run is unknown, not a pass." >&2
  exit 1
fi
PATH="$root/node_modules/.bin:$PATH"
export PATH
exec sh "$root/.husky/commit-msg" "$@"
